@startuml
skinparam classAttributeIconSize 0

class SkeletrixIsland

class ScreenAdapter
class LevelDemo
class Intro

class Spin
class GestoreLivelli
class SterlingRuby
class Scatola
interface Screen
interface Collect
interface Collidable
interface Spinnable

' Relazioni di ereditarietà
LevelDemo --|> ScreenAdapter : extends
Intro --|> ScreenAdapter : extends
ScreenAdapter ..|> Screen : implements
SterlingRuby ..|> Collect : implements
Scatola ..|> Collidable : implements
Spin ..|> Spinnable : implements

' Relazioni di associazione/composizione
LevelDemo --> SkeletrixIsland : riferito
Intro --> SkeletrixIsland : riferito
LevelDemo --> GestoreLivelli : utilizza
GestoreLivelli --> SterlingRuby : gestisce
GestoreLivelli --> Scatola : gestisce
Intro --> Spin : utilizza
Intro --> Fase : usa
LevelDemo --> GameFase : usa

interface Collect {
getX():float
getY():float
isCollected():boolean
collect():void
}

interface Collidable {
getX():float
getY():float
getBounds():Rectangle
}

interface Spinnable {
updateSpin(delta:float):void
getAngle():float
getSpinSpeed():float
}

class SkeletrixIsland {
create():void
}

class SterlingRuby {
-x:float
-y:float
-baseY:float

' Secondo l'AI si scrive cosi
-{static}WIDTH:float
-{static}HEIGHT:float
+SterlingRuby(x:float,y:float)

' Classi ovveridate
+getX():float
+getY():float
+isCollected():boolean
+collect():void

+update(skullT:float):void
}

class GestoreLivelli {
+{static}createSkulls():Array<SterlingRuby>
+{static}createCrates():Array<Scatola>
+{static}total():int
}

class Scatola {
-x:float
-y:float
-w:float
-h:float
+Scatola(textureScatole:Texture,x:float,y:float,w:float,h:float)
+getW():float
+getH():float

' Classi ovveridate
+getX():float
+getY():float
+getBounds():Rectangle

+draw(batch:SpriteBatch,cameraX:float):void
}

class Spin {
-angle:float
-{static}SPIN_SPEED:float

'Classi overridate
+updateSpin(delta:float):void
+getAngle():float
+getSpinSpeed():float

+update(delta:float):void
}

